{
  "name": "cove",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "varlock run -- node .output/server/index.mjs",
    "start:e2e": "varlock run -- node .output/server/index.mjs",
    "test": "vp test",
    "test:e2e": "playwright test --pass-with-no-tests",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "env:audit": "varlock audit",
    "env:load": "varlock load",
    "env:codegen": "varlock codegen",
    "prepare": "vp config && vp run env:codegen",
    "db": "varlock run -- drizzle-kit",
    "deps": "vpx taze@latest -Ilw --maturity-period 3",
    "tanstack": "vpx @tanstack/cli@latest",
    "ui": "vpx shadcn@latest",
    "auth": "vpx auth@latest",
    "auth:secret": "vpx auth@latest secret",
    "auth:generate": "varlock run -- vpx auth@latest generate --config ./src/lib/auth/auth.ts --y --output ./src/lib/db/schema/auth.schema.ts",
    "auth:migrate": "vpr auth:generate && vpr db generate && vpr db migrate",
    "skills": "vpx skills@latest",
    "intent": "vpx @tanstack/intent@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@fontsource-variable/inter": "5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.56",
    "@varlock/vite-integration": "1.5.2",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "evlog": "2.29.0",
    "lucide-react": "1.47.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "varlock": "1.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.103.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "nitro": "3.0.260903-beta",
    "oxc-transform-react": "0.150.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "generator": "create-cove",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
