# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Public development URL injected by Portless. Leave unset in env files.
# @optional @type=url
PORTLESS_URL=

# Public origin used by the browser and Better Auth. Override for deployment.
# @required @type=url
VITE_BASE_URL=fallback($PORTLESS_URL, "http://localhost:3000")

# PostgreSQL connection URL. Run `docker-compose up -d` for the local database.
# @required @sensitive @type=url
DATABASE_URL=postgresql://postgres:password@localhost:5432/cove

# Better Auth signing secret. Generate one with `vpr auth:secret`.
# @required @sensitive
# @docs(https://better-auth.com/docs/reference/environment-variables)
BETTER_AUTH_SECRET=

# Optional GitHub OAuth application credentials.
# @optional
GITHUB_CLIENT_ID=
# @optional @sensitive
GITHUB_CLIENT_SECRET=

# Optional Google OAuth application credentials.
# @optional
GOOGLE_CLIENT_ID=
# @optional @sensitive
GOOGLE_CLIENT_SECRET=

# NOTE:
# For OAuth2 apps, use <VITE_BASE_URL>/api/auth/callback/<provider>.
# Providers that reject .localhost domains (e.g. Google) need a custom domain
# or `PORTLESS=0 vpr dev` with a http://localhost:3000 callback.
